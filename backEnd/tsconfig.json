{
  "compilerOptions": {
    "rootDir": "./",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": false,
    "strictPropertyInitialization": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node", "jest"],
    "paths": {
      "#src/*": ["./src/*"],
      "#auth/*": ["./src/modules/authModule/*"],
      "#user/*": ["./src/modules/userModule/*"],
      "#prisma/*": ["./src/modules/prismaModule/*"],
      "#password/*": ["./src/modules/passwordModule/*"],
      "#ws/*": ["./src/modules/webSockets/*"]
    }
  }
}
